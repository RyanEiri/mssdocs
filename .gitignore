ips/upload/files/*
ips/upload/archives/*
ips/upload/tmp/*
ips/backups/*
!ips/upload/files/.gitkeep
!ips/upload/archives/.gitkeep
!ips/upload/tmp/.gitkeep
!ips/backups/.gitkeep

# CKEditor 4 for the HTML editor module: third-party, install it per ips/html_editor/README.md
ips/html_editor/ckeditor/

# A site's own additions to the admin UI (see ips/css/ips-theme.css and ips/html/ui-foot.php): never part of the base
ips/css/site-theme.css
ips/js/site-home.js

# Live config — copy config.example.php and fill in your values
ips/php/classes/config.php

# Live .htaccess — copy .htaccess.example, set GATE_COOKIE_NAME/VALUE to match config.php
ips/.htaccess

# Contacts card data — site-specific content
ips/contacts/cardfile/*.html
ips/contacts/cardfile/*.CRD
ips/contacts/cardfile/*.parsed
ips/contacts/cardfile/*.parsed.bkp


# A site's own PHP settings (see ips/php/boot.php)
ips/php/site-config.php
