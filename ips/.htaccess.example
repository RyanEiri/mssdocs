RewriteEngine On
# Add site-specific public directory exceptions here (paths accessible without login).
# Example: RewriteRule "^upload/files/public/*" - [L]

# Redirect exception for css, javascript, base images, and image_server
RewriteRule "^css/*" - [L]
RewriteRule "^js/*" - [L]
RewriteRule "^img/*" - [L]
RewriteRule "^upload/image_server.php" - [L]

# Redirect exception for public shares with keys
RewriteRule "^download.php" - [L]

# Redirect if HTTP is used instead of HTTPS
#RewriteCond %{HTTPS} !=on
#RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

# Redirect to login if no login hash detected
RewriteCond %{HTTP_COOKIE} !GATE_COOKIE_NAME=GATE_COOKIE_VALUE [NC]
RewriteRule /*	login.php
